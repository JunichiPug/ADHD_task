<div class="relative flex h-auto min-h-screen w-full flex-col bg-background group/design-root overflow-x-hidden pb-24">
  <div class="layout-container flex h-full grow flex-col">
    <div class="flex flex-1 justify-center py-5">
      <div class="layout-content-container flex flex-col max-w-[960px] flex-1 px-4 lg:px-10">

        <%# タイトル（編集画面と同じ位置・フォント） %>
        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-outline-variant py-3 mb-6">
          <div class="flex items-center text-on-surface gap-2">
            <div class="size-6 text-primary">
              <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                <path d="M42.4379 44C42.4379 44 36.0744 33.9038 41.1692 24C46.8624 12.9336 42.2078 4 42.2078 4L7.01134 4C7.01134 4 11.6577 12.932 5.96912 23.9969C0.876273 33.9029 7.27094 44 7.27094 44L42.4379 44Z" fill="currentColor"></path>
              </svg>
            </div>
            <h2 class="text-on-surface text-headline-md font-bold leading-tight tracking-[-0.015em]">メモ帳</h2>
          </div>
        </header>

        <%# 入力エリア %>
        <div class="mb-stack-gap-lg">
          <%= form_with scope: :memo, url: memos_path, method: :post, class: "block" do |f| %>
            <label class="block font-label-lg text-label-lg text-on-surface-variant mb-2" for="memo_content">新しい項目を追加</label>
            <div class="flex gap-3">
              <div class="relative flex-1">
                <%= f.text_field :content, id: "memo_content", required: true,
                      placeholder: "例: 牛乳、たまご...", autocomplete: "off",
                      class: "w-full bg-surface-container-lowest border-none ring-1 ring-outline-variant/30 focus:ring-2 focus:ring-primary px-4 py-3 rounded-xl font-body-md text-body-md transition-all placeholder:text-outline/50" %>
              </div>
              <%= f.submit "追加", class: "bg-primary-container text-on-primary-container px-6 py-3 rounded-xl font-label-lg text-label-lg cursor-pointer hover:bg-primary-container/80 transition-all active:scale-95" %>
            </div>
          <% end %>
        </div>

        <%# リスト %>
        <div class="space-y-stack-gap-sm">
          <% if @memos.any? %>
            <% @memos.each do |memo| %>
              <div class="group flex items-center justify-between p-4 bg-surface-container-lowest border border-outline-variant/10 rounded-xl transition-all hover:bg-white">
                <div class="flex items-center gap-4">
                  <%= form_with model: memo, method: :patch, class: "relative w-6 h-6 shrink-0" do |f| %>
                    <%= f.hidden_field :done, value: "0" %>
                    <%= f.check_box :done,
                          checked: memo.done,
                          onchange: "this.form.requestSubmit()",
                          class: "peer appearance-none w-6 h-6 border-2 border-primary/30 rounded-lg checked:bg-primary checked:border-primary transition-all cursor-pointer" %>
                    <span class="material-symbols-outlined absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-white text-[18px] opacity-0 peer-checked:opacity-100 pointer-events-none">check</span>
                  <% end %>
                  <span class="font-body-lg text-body-lg <%= memo.done ? "text-on-surface-variant line-through opacity-60" : "text-on-surface" %>"><%= memo.content %></span>
                </div>
                <%= button_to memo_path(memo), method: :delete,
                      class: "text-outline/40 hover:text-error transition-colors #{memo.done ? "opacity-100" : "opacity-0 group-hover:opacity-100"}" do %>
                  <span class="material-symbols-outlined">close</span>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="text-center text-on-surface-variant font-body-md py-stack-gap-lg">まだ項目がありません。上の入力欄から追加できます。</p>
          <% end %>
        </div>

        <%# 管理ボタン %>
        <% if @memos.any? %>
          <div class="mt-stack-gap-lg flex flex-col items-center gap-4">
            <div class="flex gap-gutter w-full">
              <%= button_to destroy_completed_memos_path, method: :delete,
                    form: { data: { turbo_confirm: "完了済みの項目を削除しますか？" } },
                    class: "flex-1 py-3 px-4 rounded-xl border border-outline-variant/30 font-label-sm text-label-sm text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all flex items-center justify-center gap-2" do %>
                <span class="material-symbols-outlined text-[18px]">done_all</span>
                完了済みを削除
              <% end %>
              <%= button_to destroy_all_memos_path, method: :delete,
                    form: { data: { turbo_confirm: "すべての項目を削除しますか？" } },
                    class: "flex-1 py-3 px-4 rounded-xl border border-outline-variant/30 font-label-sm text-label-sm text-error hover:bg-error-container/20 transition-all flex items-center justify-center gap-2" do %>
                <span class="material-symbols-outlined text-[18px]">delete</span>
                すべて削除
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>

  <%# BottomNavBar %>
  <nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center py-stack-gap-sm bg-surface-container border-t border-surface-variant shadow-sm">
    <%= link_to routines_path, class: "flex flex-col items-center justify-center text-outline px-6 py-2 transition-all duration-150 hover:text-primary" do %>
      <span class="material-symbols-outlined">calendar_today</span>
      <span class="text-sm font-semibold mt-1">ルーティン</span>
    <% end %>
    <%= link_to memos_path, class: "flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-full px-6 py-2 transition-all duration-150" do %>
      <span class="material-symbols-outlined">note_alt</span>
      <span class="text-sm font-semibold mt-1">メモ帳</span>
    <% end %>
  </nav>
</div>
