<div class="relative flex h-auto min-h-screen w-full flex-col bg-background group/design-root overflow-x-hidden">
  <div class="layout-container flex h-full grow flex-col">
    <div class="flex flex-1 justify-center py-5">
      <div class="layout-content-container flex flex-col max-w-[960px] flex-1 px-4 lg:px-10">
        
        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-outline-variant py-3 mb-6">
          <div class="flex items-center text-on-surface gap-2">
            <div class="size-6 text-primary">
              <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                <path d="M42.4379 44C42.4379 44 36.0744 33.9038 41.1692 24C46.8624 12.9336 42.2078 4 42.2078 4L7.01134 4C7.01134 4 11.6577 12.932 5.96912 23.9969C0.876273 33.9029 7.27094 44 7.27094 44L42.4379 44Z" fill="currentColor"></path>
              </svg>
            </div>
            <h2 class="text-on-surface text-headline-md font-bold leading-tight tracking-[-0.015em]">ルーティンの編集</h2>
          </div>
          <%= link_to routines_path, class: "flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-6 bg-surface-container-high text-on-surface text-label-lg font-bold hover:bg-surface-container-highest transition-colors" do %>
            <span class="truncate">キャンセル</span>
          <% end %>
        </header>

        <%= form_with(model: @routine, local: true) do |f| %>
          <div class="flex flex-col gap-stack-md mb-stack-lg">
            <div class="flex flex-wrap items-end gap-4">
              <label class="flex flex-col min-w-[320px] flex-1">
                <p class="text-on-surface-variant text-label-lg font-medium pb-2">ルーティン名</p>
                <%= f.text_field :title, autocomplete: "off", class: "form-input flex w-full rounded-lg text-on-surface focus:outline-0 focus:ring-2 focus:ring-primary border border-outline-variant bg-surface-container-lowest h-14 p-4 text-body-md", placeholder: "例: 朝の準備" %>
              </label>
            </div>
          </div>

          <div class="flex flex-col gap-stack-sm mb-stack-lg">
            <div class="flex items-center justify-between px-2 mb-2 mt-6">
              <h3 class="text-on-surface text-headline-md font-bold tracking-[-0.015em]">タスクリスト</h3>
            </div>

            <div id="task-fields-container" class="flex flex-col gap-4">
              <%= f.fields_for :tasks do |task_form| %>
                <div class="nested-fields flex items-center gap-4 bg-surface-container-lowest p-4 rounded-xl border border-surface-container-highest w-full">
                  <div class="cursor-grab text-outline-variant hover:text-outline p-2 flex-shrink-0">
                    <span class="material-symbols-outlined">drag_indicator</span>
                  </div>
                  
                  <div class="flex-1">
                    <%= task_form.text_field :title, autocomplete: "off", class: "w-full bg-transparent border-none focus:ring-0 text-body-lg p-0 font-semibold text-on-surface", placeholder: "新しいタスクを入力..." %>
                    
                    <div class="flex items-center gap-2 mt-2">
                      <div class="flex items-center bg-surface-container-high rounded-lg px-3 py-1.5 border border-outline-variant/30">
                        <%= task_form.number_field :duration, min: 0, class: "w-12 bg-transparent border-none p-0 text-body-md font-medium text-on-surface focus:ring-0 text-center", placeholder: "0" %>
                        <span class="text-on-surface-variant text-label-sm font-medium">分</span>
                      </div>
                      <span class="text-on-surface-variant text-label-sm">所要時間</span>
                    </div>
                  </div>

                  <div class="flex items-center flex-shrink-0">
                    <%= task_form.hidden_field :position, class: "position-field" %>
                    <%= task_form.hidden_field :_destroy, value: 0, class: "destroy-marker" %>
                    <button type="button" class="delete-task-button text-on-surface-variant hover:text-error p-2 transition-colors">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <template id="task-template">
            <%= f.fields_for :tasks, Task.new, child_index: "NEW_RECORD" do |task_form| %>
              <div class="nested-fields flex items-center gap-4 bg-surface-container-lowest p-4 rounded-xl border border-surface-container-highest w-full">
                <div class="cursor-grab text-outline-variant hover:text-outline p-2 flex-shrink-0">
                  <span class="material-symbols-outlined">drag_indicator</span>
                </div>
                <div class="flex-1">
                  <%= task_form.text_field :title, autocomplete: "off", class: "w-full bg-transparent border-none focus:ring-0 text-body-lg p-0 font-semibold text-on-surface", placeholder: "新しいタスクを入力..." %>
                  <div class="flex items-center gap-2 mt-2">
                    <div class="flex items-center bg-surface-container-high rounded-lg px-3 py-1.5 border border-outline-variant/30">
                      <%= task_form.number_field :duration, min: 0, class: "w-12 bg-transparent border-none p-0 text-body-md font-medium text-on-surface focus:ring-0 text-center", placeholder: "0" %>
                      <span class="text-on-surface-variant text-label-sm font-medium">分</span>
                    </div>
                    <span class="text-on-surface-variant text-label-sm">所要時間</span>
                  </div>
                </div>

                <div class="flex items-center flex-shrink-0">
                  <%= task_form.hidden_field :_destroy, value: 0, class: "destroy-marker" %>
                  <button type="button" class="delete-task-button text-on-surface-variant hover:text-error p-2 transition-colors">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                </div>
              </div>
            <% end %>
          </template>

          <footer class="flex flex-col gap-4 py-8 border-t border-outline-variant mt-stack-md">
            <button type="button" id="add-task-button" class="flex items-center justify-center gap-2 text-primary font-bold text-label-lg px-4 py-3 rounded-full hover:bg-primary-container transition-colors border border-primary/20 bg-primary-container/10 mb-2">
              <span class="material-symbols-outlined">add_circle</span>
              タスクを追加
            </button>
            
            <%= f.button class: "w-full bg-primary text-on-primary h-14 rounded-full font-bold text-body-lg flex items-center justify-center gap-2 shadow-sm hover:opacity-90 active:scale-[0.98] transition-all" do %>
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">save</span>
              変更を保存する
            <% end %>
          </footer>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  // 💡 Turbo環境下で安全かつ二重登録を防ぐ初期化ロジック
  //    SortableJS本体はlayoutのheadで読み込み済み（Turbo遷移でも利用可能）
  function initRoutineForm() {
    const container = document.getElementById('task-fields-container');
    const addButton = document.getElementById('add-task-button');
    const template = document.getElementById('task-template');

    if (!container) return;

    // 既存のイベントリスナーによる重複発火をクリーンに防ぐため、
    // ボタンのリスナーを一度リセット、またはプロパティ方式で安全にバインドします。
    if (addButton && template) {
      addButton.onclick = function(e) {
        e.preventDefault();
        const timeStamp = new Date().getTime();
        const html = template.innerHTML.replace(/NEW_RECORD/g, timeStamp);
        
        // 連続追加時に余計な余白(mt-4)が累積するのを防ぐため、綺麗なHTML構造で末尾に挿入
        container.insertAdjacentHTML('beforeend', html);
      };
    }

    // 削除ボタンの処理（containerに対して1回だけバインドされるので安全）
    container.onclick = function(e) {
      const deleteButton = e.target.closest('.delete-task-button');
      if (deleteButton) {
        e.preventDefault();
        const card = deleteButton.closest('.nested-fields');
        if (card) {
          const destroyMarker = card.querySelector('.destroy-marker');
          // Railsの仕様：既存データは1を立てて非表示、新規追加データはDOMごと消去
          if (destroyMarker && destroyMarker.value === '0' && destroyMarker.getAttribute('name').includes('[id]')) {
            destroyMarker.value = '1';
            card.style.display = 'none';
          } else {
            card.remove();
          }
        }
      }
    };

    // Sortable の二重初期化を防ぐ
    if (!container._sortable) {
      container._sortable = Sortable.create(container, {
        handle: '.cursor-grab',
        animation: 150,
        ghostClass: 'opacity-50'
      });
    }

    // 送信直前にDOM並び順でpositionを採番（ドラッグ・追加・削除すべてに対応）
    const form = container.closest('form');
    if (form) {
      form.onsubmit = function() {
        container.querySelectorAll('.nested-fields').forEach(function(card, i) {
          const pos = card.querySelector('.position-field');
          if (pos) pos.value = i;
        });
      };
    }
  }

  // Turboと通常ロードの両方に対応
  document.addEventListener('turbo:load', initRoutineForm);
  if (document.readyState !== 'loading') {
    initRoutineForm();
  } else {
    document.addEventListener('DOMContentLoaded', initRoutineForm);
  }
</script>