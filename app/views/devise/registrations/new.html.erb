<div class="min-h-screen flex items-start justify-center p-container-padding bg-background pt-16">

  <div class="max-w-md mx-auto w-full bg-background p-6 rounded-xl">

    <header class="mb-stack-gap-lg text-center">
    <h2 class="text-center text-2xl font-bold text-on-background mb-2">アカウント作成</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        ひびまるへようこそ
    </header>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <!-- 名前 -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          名前
        </label>

        <%= f.text_field :name,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md",
          placeholder: "パグ梅子" %>
      </div>

      <!-- メール -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          メールアドレス
        </label>

        <%= f.email_field :email,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md",
          placeholder: "example@pugpug.com" %>
      </div>

      <!-- パスワード -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          パスワード
        </label>

        <%= f.password_field :password,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md placeholder:text-outline-variant",
          placeholder: "6文字以上で入力" %>
      </div>

      <!-- パスワード確認 -->
      <div class="flex flex-col gap-2 mb-6">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          パスワードを再入力
        </label>

        <%= f.password_field :password_confirmation,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md placeholder:text-outline-variant",
          placeholder: "もう一度入力" %>
      </div>

      <!-- ボタン -->
      <button type="submit"
        class="w-full py-4 bg-primary text-on-primary rounded-full font-label-lg text-label-lg hover:opacity-90 transition-all">
        登録する
      </button>

    <% end %>

    <div class="mt-stack-gap-md mt-4 text-center">
      <%= link_to "すでにアカウントをお持ちの方はこちら",
        new_user_session_path,
        class: "font-label-lg text-primary hover:underline" %>
    </div>

  </div>

</div>
