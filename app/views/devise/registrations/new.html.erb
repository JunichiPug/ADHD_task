<div class="min-h-screen flex items-start justify-center p-container-padding bg-background pt-16">

  <div class="max-w-md mx-auto w-full bg-background p-6 rounded-xl">

    <header class="mb-stack-gap-lg text-center">
    <h2 class="text-center text-2xl font-bold text-on-background mb-2">アカウント作成</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">
        ひびまるへようこそ
    </header>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <!-- エラー表示（日本語） -->
      <% if resource.errors.any? %>
        <% has = ->(attr, type) { resource.errors.details[attr].any? { |e| e[:error] == type } } %>
        <% messages = [] %>
        <% messages << "すでに登録済みのメールアドレスです" if has.call(:email, :taken) %>
        <% messages << "メールアドレスを入力してください" if has.call(:email, :blank) %>
        <% messages << "メールアドレスの形式が正しくありません" if has.call(:email, :invalid) %>
        <% messages << "パスワードを入力してください" if has.call(:password, :blank) %>
        <% messages << "パスワードは6文字以上で入力してください" if has.call(:password, :too_short) %>
        <% messages << "パスワード（確認）が一致しません" if has.call(:password_confirmation, :confirmation) %>
        <%# 上記に該当しないエラーはそのまま表示 %>
        <% messages = resource.errors.full_messages if messages.empty? %>

        <div class="mb-4 rounded-lg border border-error/30 bg-error-container/40 px-4 py-3">
          <ul class="list-disc list-inside font-body-md text-body-md text-on-error-container">
            <% messages.uniq.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- 名前 -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          名前
        </label>

        <%= f.text_field :name,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md",
          placeholder: "パグ梅子" %>
      </div>

      <!-- メール -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          メールアドレス
        </label>

        <%= f.email_field :email,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md",
          placeholder: "example@pugpug.com" %>
      </div>

      <!-- パスワード -->
      <div class="flex flex-col gap-2 mb-4">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          パスワード
        </label>

        <%= f.password_field :password,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md placeholder:text-outline-variant",
          placeholder: "6文字以上で入力" %>
      </div>

      <!-- パスワード確認 -->
      <div class="flex flex-col gap-2 mb-6">
        <label class="font-label-lg text-label-lg text-on-surface-variant px-1">
          パスワードを再入力
        </label>

        <%= f.password_field :password_confirmation,
          class: "w-full px-4 py-4 rounded-lg border border-surface-container-high bg-white text-body-md placeholder:text-outline-variant",
          placeholder: "もう一度入力" %>
      </div>

      <!-- ボタン -->
      <button type="submit"
        class="w-full py-4 bg-primary text-on-primary rounded-full font-label-lg text-label-lg hover:opacity-90 transition-all">
        登録する
      </button>

    <% end %>

    <!-- 区切り -->
    <div class="flex items-center gap-3 my-4">
      <div class="flex-1 h-px bg-outline-variant/40"></div>
      <span class="font-label-sm text-label-sm text-on-surface-variant">または</span>
      <div class="flex-1 h-px bg-outline-variant/40"></div>
    </div>

    <!-- Google ログイン（OmniAuthはPOST必須・外部遷移のためTurbo無効） -->
    <%= button_to user_google_oauth2_omniauth_authorize_path,
          data: { turbo: false },
          class: "w-full py-4 bg-white border border-surface-container-high rounded-full font-label-lg text-label-lg text-on-surface flex items-center justify-center gap-3 hover:bg-surface-container-low transition-all duration-300 shadow-sm cursor-pointer" do %>
      <svg class="w-5 h-5" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      Googleで続ける
    <% end %>

    <div class="mt-stack-gap-md mt-4 text-center">
      <%= link_to "すでにアカウントをお持ちの方はこちら",
        new_user_session_path,
        class: "font-label-lg text-primary hover:underline" %>
    </div>

  </div>

</div>
