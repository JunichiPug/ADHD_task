<!DOCTYPE html><html class="light" lang="ja"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-variant": "#e4e2de",
                        "surface-container-low": "#f5f3ef",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a",
                        "surface-container": "#efeeea",
                        "surface": "#fbf9f5",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#53646e",
                        "on-surface": "#1b1c1a",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-fixed": "#0c1e25",
                        "tertiary": "#50616a",
                        "on-secondary-container": "#5c694b",
                        "primary": "#725764",
                        "on-secondary": "#ffffff",
                        "tertiary-fixed": "#d3e5f0",
                        "primary-fixed": "#fdd9e9",
                        "inverse-primary": "#e0bdcd",
                        "secondary": "#566246",
                        "inverse-on-surface": "#f2f0ed",
                        "surface-dim": "#dbdad6",
                        "on-secondary-fixed-variant": "#3f4b30",
                        "tertiary-fixed-dim": "#b7c9d4",
                        "outline-variant": "#d1c3c8",
                        "secondary-container": "#dae8c3",
                        "on-background": "#1b1c1a",
                        "outline": "#7f7478",
                        "surface-tint": "#725764",
                        "surface-bright": "#fbf9f5",
                        "error-container": "#ffdad6",
                        "background": "#fbf9f5",
                        "primary-container": "#f9d5e5",
                        "primary-fixed-dim": "#e0bdcd",
                        "surface-container-high": "#eae8e4",
                        "surface-container-highest": "#e4e2de",
                        "on-secondary-fixed": "#141f08",
                        "on-primary-container": "#765a68",
                        "on-primary": "#ffffff",
                        "on-surface-variant": "#4e4448",
                        "inverse-surface": "#30312e",
                        "secondary-fixed-dim": "#becba8",
                        "on-tertiary-fixed-variant": "#384952",
                        "secondary-fixed": "#dae8c3",
                        "on-primary-fixed": "#2a1520",
                        "on-primary-fixed-variant": "#593f4c",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#cfe1ec"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-padding": "24px",
                        "unit": "8px",
                        "gutter": "16px",
                        "stack-gap-lg": "40px",
                        "stack-gap-sm": "12px",
                        "stack-gap-md": "24px"
                    },
                    "fontFamily": {
                        "label-lg": ["Atkinson Hyperlegible Next"],
                        "body-md": ["Atkinson Hyperlegible Next"],
                        "headline-lg": ["Atkinson Hyperlegible Next"],
                        "body-lg": ["Atkinson Hyperlegible Next"],
                        "label-sm": ["Atkinson Hyperlegible Next"],
                        "headline-md": ["Atkinson Hyperlegible Next"]
                    },
                    "fontSize": {
                        "label-lg": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.01em", "fontWeight": "600"}],
                        "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "headline-lg": ["32px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}],
                        "label-sm": ["12px", {"lineHeight": "1.2", "fontWeight": "600"}],
                        "headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Atkinson Hyperlegible Next', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .soft-outline {
            border: 1px solid rgba(127, 116, 120, 0.1);
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-container-padding">
<!-- Main Container -->
<main class="w-full max-w-[1200px] bg-surface-container-lowest rounded-xl overflow-hidden soft-outline max-w-md mx-auto">
<!-- Left Column: Visual/Marketing Side -->

<!-- Right Column: Login Form -->
<div class="flex flex-col justify-center items-center p-stack-gap-lg bg-surface">
<div class="w-full max-w-sm">
<!-- Brand Header -->
<header class="text-center mb-stack-gap-lg">
  <img src="/hibimaru_pug.png"
         alt="ひびまるロゴ"
         style="width:250px; height:auto; margin:0 auto 4px; display:block; border-radius:12px;">
<h1 class="font-headline-md text-3xl font-bold text-primary mb-2">ひびまる</h1>
<p class="font-body-md text-body-md text-on-surface-variant">毎日のルーティンを
やさしく見える化<br>

ドーナツグラフで
今日やることをひと目で確認<br>
自分のペースで、静かに始めましょう。</p>
</header>
<!-- Form Section -->
<section class="space-y-stack-gap-md">
<!-- Email Field -->
<div class="space-y-2">
<label class="block font-label-lg text-label-lg text-on-surface-variant" for="email">メールアドレス</label>
<input class="w-full px-4 py-3 bg-surface-container-lowest border-2 border-transparent focus:border-primary-container focus:ring-0 rounded-lg transition-all duration-300 font-body-md text-on-surface placeholder:text-outline-variant soft-outline" id="email" placeholder="example@steadyflow.jp" type="email">
</div>
<!-- Password Field -->
<div class="space-y-2">
<label class="block font-label-lg text-label-lg text-on-surface-variant" for="password">パスワード</label>
<input class="w-full px-4 py-3 bg-surface-container-lowest border-2 border-transparent focus:border-primary-container focus:ring-0 rounded-lg transition-all duration-300 font-body-md text-on-surface placeholder:text-outline-variant soft-outline" id="password" placeholder="••••••••" type="password">
</div>
<!-- Actions -->
<div class="flex flex-col space-y-gutter pt-2">
<button class="w-full py-4 bg-primary text-on-primary font-label-lg text-label-lg rounded-full hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-sm">
                            ログイン
                        </button>
<div class="flex flex-col items-center space-y-stack-gap-sm pt-4">
<%= link_to "新規登録はこちら",
    new_user_registration_path,
    class: "font-label-lg text-label-lg text-secondary hover:text-on-secondary-fixed-variant transition-colors underline decoration-secondary-container decoration-2 underline-offset-4" %>

</div>
</div>
</section>
<!-- Social Login Separator -->

<!-- Social Actions -->

</div>
<!-- Footer Small Print -->
<footer class="mt-stack-gap-lg text-center opacity-60">
<p class="font-label-sm text-label-sm text-outline">
                    © 2026 JunichiPug. すべての人が穏やかに過ごせるように。
                </p>
</footer>
</div>
</main>
<!-- Decorative Soft Elements -->
<div class="fixed top-12 left-12 w-32 h-32 bg-tertiary-container/20 rounded-full blur-2xl -z-10"></div>
<div class="fixed bottom-12 right-12 w-48 h-48 bg-primary-container/20 rounded-full blur-3xl -z-10"></div>




</body></html>

