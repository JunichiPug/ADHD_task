<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ひびまる" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#fbf9f5">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="ひびまる">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Atkinson Hyperlegible Next', sans-serif; -webkit-font-smoothing: antialiased; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .donut-chart { transform: rotate(-90deg); }
        .soft-outline { border: 1px solid rgba(127, 116, 120, 0.1); }
    </style>

    <!-- ★ Tailwind Play CDN（全ページ共通・ここで1回だけ読み込む） -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- ② ★ Tailwind 設定（全ページ共通のフルパレット） -->
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
              "secondary": "#566246", "surface-variant": "#e4e2de", "on-surface": "#1b1c1a", "on-tertiary": "#ffffff", "secondary-container": "#dae8c3", "tertiary-fixed": "#d3e5f0", "primary-container": "#f9d5e5", "secondary-fixed": "#dae8c3", "surface": "#fbf9f5", "error-container": "#ffdad6", "on-secondary-fixed-variant": "#3f4b30", "surface-container": "#efeeea", "error": "#ba1a1a", "on-secondary": "#ffffff", "on-tertiary-container": "#53646e", "surface-dim": "#dbdad6", "surface-tint": "#725764", "surface-container-highest": "#e4e2de", "on-tertiary-fixed-variant": "#384952", "inverse-surface": "#30312e", "primary-fixed": "#fdd9e9", "on-secondary-container": "#5c694b", "on-primary-fixed": "#2a1520", "outline-variant": "#d1c3c8", "outline": "#7f7478", "on-primary-fixed-variant": "#593f4c", "background": "#fbf9f5", "on-primary": "#ffffff", "on-secondary-fixed": "#141f08", "surface-container-high": "#eae8e4", "inverse-on-surface": "#f2f0ed", "primary-fixed-dim": "#e0bdcd", "on-error": "#ffffff", "tertiary": "#50616a", "surface-container-lowest": "#ffffff", "on-primary-container": "#765a68", "primary": "#725764", "surface-container-low": "#f5f3ef", "surface-bright": "#fbf9f5", "on-error-container": "#93000a", "tertiary-fixed-dim": "#b7c9d4", "on-background": "#1b1c1a", "tertiary-container": "#cfe1ec", "inverse-primary": "#e0bdcd", "on-surface-variant": "#4e4448", "secondary-fixed-dim": "#becba8", "on-tertiary-fixed": "#0c1e25"
            },
            "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "999px" },
            "spacing": { "gutter": "16px", "stack-gap-md": "24px", "container-padding": "24px", "unit": "8px", "stack-gap-sm": "12px", "stack-gap-lg": "40px" },
            "fontFamily": {
              "label-lg": ["Atkinson Hyperlegible Next"], "body-md": ["Atkinson Hyperlegible Next"],
              "headline-lg": ["Atkinson Hyperlegible Next"], "body-lg": ["Atkinson Hyperlegible Next"],
              "label-sm": ["Atkinson Hyperlegible Next"], "headline-md": ["Atkinson Hyperlegible Next"]
            },
            "fontSize": {
              "label-lg": ["14px", {"lineHeight": "1.2", "letterSpacing": "0.01em", "fontWeight": "600"}],
              "body-md": ["16px", {"lineHeight": "1.6", "fontWeight": "400"}],
              "headline-lg": ["32px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700"}],
              "body-lg": ["18px", {"lineHeight": "1.6", "fontWeight": "400"}],
              "label-sm": ["12px", {"lineHeight": "1.2", "fontWeight": "600"}],
              "headline-md": ["24px", {"lineHeight": "1.3", "fontWeight": "700"}]
            }
          }
        }
      }
    </script>

    <!-- ★ SortableJS（ドラッグ並び替え・全ページ共通。Turbo遷移でも常に利用可能にするためhead/deferで読み込む） -->
    <script defer src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <!-- ここがポイント（画面全体の背景） -->
  <body class="bg-background text-on-background min-h-screen pb-[env(safe-area-inset-bottom)]">

    <!-- ヘッダー（全ページ共通） -->
    <header class="w-full flex justify-between items-center px-6 pt-[calc(1rem+env(safe-area-inset-top))] pb-4">

      <!-- 左：アプリ名 -->
      <div class="font-bold text-primary">
        ひびまる
      </div>

      <!-- 右：ログアウト（ログイン時だけ表示） -->
      <div>
        <% if user_signed_in? %>
          <%= button_to "ログアウト",
              destroy_user_session_path,
              method: :delete,
              class: "text-sm text-red-500 hover:underline" %>
        <% end %>
      </div>

    </header>

    <!-- メイン画面（各ページの中身がここに入る） -->
    <main>
      <%= yield %>
    </main>

  </body>
</html>